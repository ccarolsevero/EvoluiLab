generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaidBy {
  LUANA
  ANDRESSA
  ANA_CAROLINA
}

enum CostType {
  CUSTO
  PROLABORE
  FUNDO_CAIXA
}

enum PaymentStatus {
  PENDENTE
  PAGO
  ATRASADO
}

enum ClientPaymentStatus {
  PENDENTE
  PAGO
  PARCELADO_CARTAO
  PIX
}

enum DocumentKind {
  DOCUMENTO
  ANAMNESE
}

model CostEntry {
  id            String        @id @default(cuid())
  amount        Float
  description   String
  paymentDate   DateTime
  paymentStatus PaymentStatus @default(PENDENTE)
  paidBy        PaidBy
  type          CostType      @default(CUSTO)
  observation   String        @default("")
  /// Se preenchido, este lançamento é a baixa automática no caixa ligada a outro custo/pró-labore
  relatedCostId String?
  relatedCost   CostEntry?    @relation("CashWriteOff", fields: [relatedCostId], references: [id], onDelete: Cascade)
  cashWriteOffs CostEntry[]   @relation("CashWriteOff")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([relatedCostId])
}

model Client {
  id            String              @id @default(cuid())
  name          String
  hireDate      DateTime
  /// Resumo dos nomes dos serviços (para busca/listagem), ex.: "Site · Landing"
  service       String
  /// JSON: [{ "name": "Site", "amount": 1500 }, ...] — legado: [1500, 500]
  valuesJson    String              @default("[]")
  totalValue    Float
  paymentStatus ClientPaymentStatus @default(PENDENTE)
  observation   String              @default("")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  documents     ClientDocument[]
}

model ClientDocument {
  id           String       @id @default(cuid())
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind         DocumentKind
  originalName String
  fileName     String
  mimeType     String
  size         Int
  createdAt    DateTime     @default(now())
}
